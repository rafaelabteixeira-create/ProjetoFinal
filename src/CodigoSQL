CREATE DATABASE Projeto2Ano
GO


USE Projeto2Ano

CREATE TABLE Pais
(
Id_Pais INT PRIMARY KEY IDENTITY (1,1),
Tag_Pais VARCHAR (3) UNIQUE NOT NULL,
Nome_Pais VARCHAR (20)NOT NULL
);

CREATE TABLE Pontos 
(
Id_Pontos INT PRIMARY KEY IDENTITY (1,1),
Nome VARCHAR(5) NOT NULL,
Pais VARCHAR (3)NOT NULL,	
Conta VARCHAR (20)NOT NULL,
Pontuacao INT,

CONSTRAINT FK_Pontos_Pais
    FOREIGN KEY (Pais) REFERENCES Pais(Tag_Pais)
);


CREATE TABLE Provincias 
(
Id_Provincias INT PRIMARY KEY IDENTITY (1,1),
Nome VARCHAR (20)Unique NOT NULL,
Controlador VARCHAR(3),
N_Tropas INT NOT NULL,
Paz_War BIT NOT NULL

CONSTRAINT FK_Provincias_Pais
    FOREIGN KEY (Controlador) REFERENCES Pais(Tag_Pais)
);



